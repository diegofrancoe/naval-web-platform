# Server-side only. Configure the real Make webhook in the hosting environment.
MAKE_WEBHOOK_URL=

# Optional server-side AI fallback. Uses the OpenAI Responses API when Make is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional public browser configuration. When empty, the site uses /api/make-webhook.
# VITE_* values are embedded in the browser bundle and must never contain secrets.
VITE_MAKE_WEBHOOK_ENDPOINT=
